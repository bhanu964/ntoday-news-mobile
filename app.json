{
  "expo": {
    "name": "N Today News",
    "slug": "n-today-news",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "ntoday",
      "ntodaynewsmobile"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ntodaynews.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.ntodaynews.app",
      "adaptiveIcon": {
        "backgroundColor": "#020D23",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020D23",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#020D23",
            "image": "./assets/splash.png"
          },
          "android": {
            "backgroundColor": "#020D23",
            "image": "./assets/images/ntoday-official-logo.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#020D23",
              "image": "./assets/images/ntoday-official-logo.png"
            }
          },
          "ios": {
            "backgroundColor": "#020D23",
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": true,
            "dark": {
              "backgroundColor": "#020D23",
              "image": "./assets/splash.png"
            }
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "38e2117d-ba99-471a-a477-8fd598a9acea"
      }
    },
    "owner": "bhanu_cheg"
  }
}
